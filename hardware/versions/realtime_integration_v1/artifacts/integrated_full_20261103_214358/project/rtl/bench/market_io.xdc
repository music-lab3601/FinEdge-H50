# Wujing full board manual pp.19-20. RGMII bank13: 1.8 V; reset bank12: 3.3 V.
set_property PACKAGE_PIN AD23 [get_ports PL_PHY_TX_CLK]
set_property PACKAGE_PIN AD26 [get_ports PL_PHY_TX_CTRL]
set_property PACKAGE_PIN AF24 [get_ports {PL_PHY_TXD[0]}]
set_property PACKAGE_PIN AF25 [get_ports {PL_PHY_TXD[1]}]
set_property PACKAGE_PIN AA24 [get_ports {PL_PHY_TXD[2]}]
set_property PACKAGE_PIN AB24 [get_ports {PL_PHY_TXD[3]}]
set_property PACKAGE_PIN AC23 [get_ports PL_PHY_RX_CLK]
set_property PACKAGE_PIN AA25 [get_ports PL_PHY_RX_CTRL]
set_property PACKAGE_PIN AB26 [get_ports {PL_PHY_RXD[0]}]
set_property PACKAGE_PIN AC26 [get_ports {PL_PHY_RXD[1]}]
set_property PACKAGE_PIN AE25 [get_ports {PL_PHY_RXD[2]}]
set_property PACKAGE_PIN AE26 [get_ports {PL_PHY_RXD[3]}]
set_property PACKAGE_PIN AE22 [get_ports PL_PHY_MDC]
set_property PACKAGE_PIN AF22 [get_ports PL_PHY_MDIO]
set_property IOSTANDARD LVCMOS18 [get_ports {PL_PHY_TX_CLK PL_PHY_TX_CTRL PL_PHY_TXD[*] PL_PHY_RX_CLK PL_PHY_RX_CTRL PL_PHY_RXD[*] PL_PHY_MDC PL_PHY_MDIO}]
set_property PACKAGE_PIN AA13 [get_ports PL_PHY_RESET]
set_property IOSTANDARD LVCMOS33 [get_ports PL_PHY_RESET]
set_property SLEW FAST [get_ports {PL_PHY_TX_CLK PL_PHY_TX_CTRL PL_PHY_TXD[*]}]
create_clock -name market_rgmii_rx -period 8.000 [get_ports PL_PHY_RX_CLK]
# Candidate RX external timing: PHY shifts its RX clock by 0.750 ns, so data
# transitions occur 2.25..4.25 ns after the PRECEDING DDR edge. This is the
# positive launch-edge representation of -2.5..-1.0 ns before this edge.
# Include external skew/jitter margin; pending board validation, no vendor signoff.
set_input_delay -clock market_rgmii_rx -max 4.25 [get_ports {PL_PHY_RXD[*] PL_PHY_RX_CTRL}]
set_input_delay -clock market_rgmii_rx -min 2.25 [get_ports {PL_PHY_RXD[*] PL_PHY_RX_CTRL}]
set_input_delay -clock market_rgmii_rx -clock_fall -add_delay -max 4.25 [get_ports {PL_PHY_RXD[*] PL_PHY_RX_CTRL}]
set_input_delay -clock market_rgmii_rx -clock_fall -add_delay -min 2.25 [get_ports {PL_PHY_RXD[*] PL_PHY_RX_CTRL}]
# TX clock is generated with 90-degree skew by the MAC, not by PHY TX delay.
create_generated_clock -name market_rgmii_tx -source [get_pins U_window_ddr/clocks/inst/mmcm_adv_inst/CLKOUT1] -divide_by 1 [get_ports PL_PHY_TX_CLK]
set_output_delay -clock market_rgmii_tx -max 1.0 [get_ports {PL_PHY_TXD[*] PL_PHY_TX_CTRL}]
set_output_delay -clock market_rgmii_tx -min -1.0 [get_ports {PL_PHY_TXD[*] PL_PHY_TX_CTRL}]
set_output_delay -clock market_rgmii_tx -clock_fall -add_delay -max 1.0 [get_ports {PL_PHY_TXD[*] PL_PHY_TX_CTRL}]
set_output_delay -clock market_rgmii_tx -clock_fall -add_delay -min -1.0 [get_ports {PL_PHY_TXD[*] PL_PHY_TX_CTRL}]
set_false_path -to [get_ports {PL_PHY_MDC PL_PHY_MDIO PL_PHY_RESET}]
set_false_path -from [get_ports PL_PHY_MDIO]
